    "react-dom": "^19.0.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "npm:esbuild-wasm@^0.24.2",
    "postcss": "^8.4.49",
    "rollup": "npm:@rollup/wasm-node@^4.30.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1"
  },
  "overrides": {
    "esbuild": "npm:esbuild-wasm@^0.24.2",
