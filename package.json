{
  "name": "pal-scope",
  "private": true,
  "version": "1.0.0",
  "description": "PAL-Scope — Bench-Side Progressive Addition Lens Identifier & Vision Enhancement PWA",
  "type": "module",
  "scripts": {
    "dev": "node --require ./scripts/crypto-polyfill.cjs ./node_modules/vite/bin/vite.js",
